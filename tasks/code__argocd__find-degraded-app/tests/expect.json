    "record_facts": {
      "requirement": "Name the Argo CD application that is Degraded on production (its failing Deployment has the same name), the image tag its failing pod runs, and why that pod is not starting (the reason it is waiting, or the cause its events give for that reason).",
      "selector": {
        "collection": "/services/argocd/applications",
        "matching": {
          "metadata": {
            "labels": {
              "env": "production"
            }
          },
          "status": {
            "health": {
              "status": "Degraded"
            }
          }
        },
        "key_prefix": null,
        "created": false,
        "identity_field": null
      },
      "selection": "only",
      "facts": {
        "app": {
          "field": "/metadata/name",
          "kind": "text"
        },
        "image_tag": {
          "field": "/images/0",
          "kind": "identifier",
          "record": "pod",
          "capture": ":([^:/]+)$"
        },
        "pod_name": {
          "field": "/name",
          "kind": "identifier",
          "optional": true,
          "record": "pod"
        },
        "reason": {
          "field": "/manifest/status/containerStatuses/0/state/waiting/reason",
          "kind": "text",
          "record": "pod",
          "also": [
