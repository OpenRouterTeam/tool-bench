    "regex": null,
    "record_facts": {
      "requirement": "From the invoice email Northwind Traders sent for October services, give the PO number it references, the amount due in US dollars, and the due date.",
      "selector": {
        "collection": "/services/google/gmail_messages",
        "matching": {},
        "field_patterns": {
          "/headers/From": "^Northwind Traders\\b",
          "/headers/Subject": "^Invoice\\b.*\\bOctober\\b"
        },
        "key_prefix": null,
        "created": false,
        "identity_field": null
      },
      "selection": "only",
      "facts": {
        "amount": {
          "field": "/body_text",
          "kind": "money",
          "capture": "(?m)^Amount due: \\$([\\d,]+(?:\\.\\d+)?)$"
        },
        "draft_amount": {
          "field": "/body_text",
          "kind": "money",
          "optional": true,
          "capture": "draft figure of \\$(\\d[\\d,]*(?:\\.\\d+)?)"
        },
        "due": {
          "field": "/body_text",
          "kind": "date",
          "capture": "(?m)^Due date: (.+)$"
        },
        "po": {
          "field": "/body_text",
          "kind": "identifier",
          "capture": "(?m)^PO number: (\\S+)$"
        }
      },
      "mode": "statements",
      "context": [
        "this replaces the earlier draft figure of ${draft_amount}"
      ]
    }
  },
  "preservation": null,
  "interfaces": "mcp_only",
  "environment_faults": []
