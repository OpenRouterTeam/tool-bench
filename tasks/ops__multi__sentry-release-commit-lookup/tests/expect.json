  "answer": {
    "contains": [],
    "regex": null,
    "record_facts": {
      "requirement": "Name the unresolved Sentry issue of the storefront-web project that has the most events (short ID), the release it first appeared in, the number of the GitHub pull request whose merge commit is that release's commit, and that pull request's author.",
      "selector": {
        "collection": "/services/sentry/issues",
        "matching": {
          "project": "storefront-web",
          "status": "unresolved"
        },
        "key_prefix": null,
        "created": false,
        "identity_field": null
      },
      "selection": {
        "largest": {
          "field": "/count"
        }
      },
      "facts": {
        "author": {
          "field": "/name",
          "kind": "text",
          "record": "author",
          "also": [
            "/login"
          ]
        },
        "commit_message": {
          "field": "/commits/0/message",
          "kind": "text",
          "optional": true,
          "record": "release"
        },
        "commit_sha": {
          "field": "/commits/0/id",
          "kind": "identifier",
          "optional": true,
          "record": "release",
          "capture": "^(.{7})"
        },
        "commit_title": {
          "field": "/commits/0/message",
          "kind": "text",
          "optional": true,
          "record": "release",
          "capture": "^(?:feat|fix|chore|perf|refactor|docs|style|test|ci|build|revert)(?:\\([^)]+\\))?: (.+)"
        },
        "event_count": {
          "field": "/count",
          "kind": "number",
          "optional": true
        },
        "issue_id": {
          "field": "/shortId",
          "kind": "identifier"
        },
        "pull_request": {
          "field": "/number",
          "kind": "number",
          "record": "pull",
          "units": [
            "#",
            "pr",
            "request",
            "number"
          ],
          "require_unit": true
        },
        "release": {
          "field": "/version",
          "kind": "identifier",
          "record": "release"
        }
      },
      "mode": "statements",
      "related": {
        "author": {
          "from": "pull",
          "collection": "/services/github/users",
          "on": {
            "/login": "/user"
          }
        },
        "pull": {
          "from": "release",
          "collection": "/services/github/pulls",
          "on": {
            "/merge_commit_sha": "/commits/0/id"
          }
        },
        "release": {
          "collection": "/services/sentry/releases",
          "on": {
            "/version": "/firstRelease"
          }
        }
      },
      "context": [
        "(https://github.com/lumen-labs/storefront/pull/${pull_request})",
        "(${event_count} events, unresolved)",
        "(single commit ${commit_sha}, \"${commit_message}\")",
        "commit title: \"${commit_title}\""
      ],
      "contradictions": [
        "fewest",
        "least frequent",
        "least noisy",
        "quietest"
      ],
      "assertions": [
        "Issue ${issue_id} first appeared in release ${release}. It was introduced by PR #${pull_request}, authored by ${author}.",
        "${issue_id}, ${release}, pull request ${pull_request} by @${author}",
        "${issue_id}, ${release}, PR #${pull_request}, ${author}",
        "${issue_id} first appeared in ${release}; PR #${pull_request} by ${author}",
        "| Sentry issue | ${issue_id} | | First release | ${release} | | Pull request | #${pull_request} | | Author | ${author} |",
        "- Sentry issue: ${issue_id} - First seen in release: ${release} - Pull request: #${pull_request} - Author: ${author}"
      ]
    }
  },
  "preservation": null,
  "interfaces": "mcp_only",
  "environment_faults": []
