      "requirement": "Name the job that failed in the latest CI run of pull request #42's branch, the test that failed in that job, and the exact assertion message its log prints for that test.",
      "selector": {
        "collection": "/services/github/pulls",
        "matching": {
          "number": 42
        },
        "key_prefix": "octo-org/payments-api#",
        "created": false,
        "identity_field": null
      },
      "selection": "only",
      "facts": {
        "assertion": {
          "field": "/log",
          "kind": "text",
          "record": "job",
          "capture": "_test\\.go:\\d+: (.+)"
        },
        "job": {
          "field": "/name",
          "kind": "text",
          "record": "job"
        },
        "run_id": {
          "field": "/id",
          "kind": "identifier",
          "optional": true,
          "record": "run"
        },
        "test": {
          "field": "/log",
          "kind": "identifier",
          "record": "job",
          "capture": "--- FAIL: (\\S+)"
        },
        "test_file": {
          "field": "/log",
          "kind": "identifier",
          "optional": true,
          "record": "job",
          "capture": "(\\S+_test\\.go):\\d+:"
        },
        "test_location": {
          "field": "/log",
          "kind": "identifier",
          "optional": true,
          "record": "job",
          "capture": "(\\S+_test\\.go:\\d+):"
        }
      },
      "mode": "statements",
