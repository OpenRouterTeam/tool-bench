    "record_facts": {
      "requirement": "Name the Argo CD application that is Degraded on production and the image tag its failing pod runs, the ID of the GitLab pipeline named by the deploy commit that application is synced to, the job that failed in that pipeline, and the error that job's log reports.",
      "selector": {
        "collection": "/services/argocd/applications",
        "matching": {
          "metadata": {
            "labels": {
              "env": "production"
            }
          },
          "status": {
            "health": {
              "status": "Degraded"
            }
          }
        },
        "key_prefix": null,
        "created": false,
        "identity_field": null
      },
      "selection": "only",
      "facts": {
        "app": {
          "field": "/metadata/name",
          "kind": "text"
        },
        "commit_sha": {
          "field": "/id",
          "kind": "identifier",
          "optional": true,
          "record": "commit",
          "min_prefix": 7
        },
        "error": {
          "field": "/trace",
          "kind": "identifier",
          "record": "job",
          "capture": "(?m)^denied: (\\w+):",
          "wordings": {
            "permission_denied": [
              "permission denied",
              "denied",
              "expired",
              "scopes"
            ]
          }
        },
        "image_tag": {
          "field": "/images/0",
          "kind": "identifier",
          "record": "pod",
          "capture": ":([^:/]+)$"
        },
        "job": {
          "field": "/name",
          "kind": "text",
          "record": "job"
        },
        "pipeline": {
          "field": "/id",
          "kind": "identifier",
          "record": "pipeline"
        },
        "scope": {
          "field": "/trace",
          "kind": "identifier",
          "optional": true,
          "record": "scope_trace",
          "capture": "expected scopes \\(([^)]+)\\)"
        }
      },
      "mode": "statements",
      "related": {
        "commit": {
          "collection": "/services/gitlab/commits",
          "on": {
            "/id": "/status/sync/revision"
          }
        },
        "job": {
          "from": "pipeline",
          "collection": "/services/gitlab/jobs",
          "filter": {
            "matching": {
              "/status": "failed"
            }
          },
          "on": {
            "/pipeline_id": "/id"
          }
        },
        "pipeline": {
          "from": "commit",
          "collection": "/services/gitlab/pipelines",
          "on": {
            "/id": "/message"
          },
          "capture_from": {
            "/message": "pipeline #(\\d+)"
          }
        },
        "pod": {
          "collection": "/services/argocd/resources",
          "filter": {
            "matching": {
              "/kind": "Pod"
            },
            "excluding": [
              {
                "/health/status": "Healthy"
              }
            ]
          },
          "on": {
            "/manifest/metadata/labels/app.kubernetes.io~1instance": "/metadata/name"
          }
        },
        "scope_trace": {
          "allow_absence": true,
          "from": "job",
          "collection": "/services/gitlab/jobs",
          "filter": {
            "patterns": {
              "/trace": "expected scopes \\([^)]+\\)"
            }
          },
          "on": {
            "/id": "/id"
          }
        }
      },
