{
  "version": 2,
  "state": [],
  "records": [],
  "relations": [],
  "audit_history": true,
  "ordering": [],
  "required_calls": [],
  "forbidden_calls": [],
  "answer": {
    "contains": [],
    "regex": null,
    "record_facts": {
      "requirement": "State the monthly price in US dollars of Northwind Analytics' Team plan when billed annually, and the number of seats that plan includes, according to the company's own current pricing page.",
      "selector": {
        "collection": "/services/firecrawl/pages",
        "matching": {},
        "field_patterns": {
          "/title": "^Pricing \\| Northwind Analytics$"
        },
        "key_prefix": null,
        "created": false,
        "identity_field": null
      },
      "selection": "only",
      "facts": {
        "price": {
          "field": "/markdown",
          "kind": "money",
          "capture": "Team(?:\\n\\n|\\*\\* plan is| \\|) ?(?:\\*\\*)?\\$(\\d+)(?:/| per )month",
          "units": [
            "usd",
            "dollars"
          ],
          "require_unit": true
        },
        "seats": {
          "field": "/markdown",
          "kind": "number",
          "capture": "Team[^#]*?(\\d+) (?:seats|users)",
          "units": [
            "seats",
            "seat",
            "users",
            "user"
          ],
          "require_unit": true
        },
        "source_url": {
          "field": "/_key",
          "kind": "identifier",
          "optional": true
        }
      },
      "mode": "statements",
      "context": [
        "(Source: ${source_url})",
        "Northwind Analytics"
      ]
    }
  },
  "preservation": null,
  "interfaces": "mcp_only",
  "environment_faults": []
}
