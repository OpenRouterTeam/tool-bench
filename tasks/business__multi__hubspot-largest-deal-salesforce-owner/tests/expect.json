    "record_facts": {
      "requirement": "Name the company associated with the largest non-archived HubSpot deal that is neither closed won nor closed lost, the Salesforce user who owns the account of that name, and the case number of every open (not closed) Salesforce case on that account.",
      "selector": {
        "collection": "/services/hubspot/deals",
        "matching": {
          "archived": false
        },
        "key_prefix": null,
        "created": false,
        "identity_field": null
      },
      "selection": {
        "largest": {
          "field": "/properties/amount"
        }
      },
      "facts": {
        "cases": {
          "field": "/CaseNumber",
          "kind": "identifier",
          "record": "cases"
        },
        "company": {
          "field": "/properties/name",
          "kind": "text",
          "record": "company"
        },
        "owner": {
          "field": "/Name",
          "kind": "text",
          "record": "owner"
        }
      },
      "mode": "statements",
      "rejected": [
        "has no open cases",
        "${cases} is closed",
        "${cases} are closed"
      ],
      "filter": {
        "excluding": [
          {
            "/properties/dealstage": "closedwon"
          },
          {
            "/properties/dealstage": "closedlost"
          }
        ]
      },
      "related": {
        "account": {
          "from": "company",
          "collection": "/services/salesforce/Account",
          "on": {
            "/Name": "/properties/name"
          }
        },
        "cases": {
          "from": "account",
          "collection": "/services/salesforce/Case",
          "filter": {
            "matching": {
              "/IsClosed": false
            }
          },
          "on": {
            "/AccountId": "/Id"
          },
          "pick": "all"
        },
        "company": {
          "from": "link",
          "collection": "/services/hubspot/companies",
          "on": {
            "/id": "/fromObjectId"
          }
        },
        "link": {
          "collection": "/services/hubspot/associations",
          "filter": {
            "matching": {
              "/fromObjectType": "companies",
              "/toObjectType": "deals"
            }
          },
          "on": {
            "/toObjectId": "/id"
          }
        },
        "owner": {
          "from": "account",
          "collection": "/services/salesforce/User",
          "on": {
            "/Id": "/OwnerId"
          }
        }
      },
      "context": [
        "(Escalated)",
        "(Working)",
        "(New)",
        "(Closed)",
        "(High)",
        "(Medium)",
        "(Low)"
      ]
    }
