{
  "version": 2,
  "state": [],
  "records": [],
  "relations": [],
  "audit_history": true,
  "ordering": [],
  "required_calls": [
    {
      "service": "brave",
      "method": "GET",
      "path": null,
      "path_regex": "^/res/v1/",
      "query_contains": null,
      "body": null,
      "body_contains": null,
      "min_count": 1,
      "response_status": [],
      "allow_tool_error": false
    }
  ],
  "forbidden_calls": [],
  "answer": {
    "contains": [],
    "regex": null,
    "record_facts": {
      "requirement": "State the amount (in millions of US dollars), the round and the lead investor of the funding round that Norvik Analytics announced in the news during the week of 2026-10-29.",
      "selector": {
        "collection": "/services/brave/news",
        "matching": {},
        "field_patterns": {
          "/page_age": "^2026-10-2[3-9]T",
          "/title": "^Norvik Analytics (raises|closes|secures|announces) "
        },
        "key_prefix": null,
        "created": false,
        "identity_field": null
      },
      "selection": "only",
      "facts": {
        "amount": {
          "field": "/title",
          "kind": "money",
          "capture": "\\$(\\d+(?:\\.\\d+)?)M\\b",
          "units": [
            "million",
            "m",
            "mn"
          ],
          "require_unit": true
        },
        "lead": {
          "field": "/description",
          "kind": "text",
          "capture": "led by ([A-Z][A-Za-z]+(?: [A-Z][A-Za-z]+)*)"
        },
        "news_date": {
          "field": "/page_age",
          "kind": "date",
          "optional": true
        },
        "news_source": {
          "field": "/source",
          "kind": "text",
          "optional": true
        },
        "participating_investor": {
          "field": "/description",
          "kind": "text",
          "optional": true,
          "capture": "participation from (?:existing investor )?([A-Z][A-Za-z]+(?: [A-Z][A-Za-z]+)*)"
        },
        "round": {
          "field": "/title",
          "kind": "text",
          "capture": "\\b(Series [A-Z])\\b"
        },
        "total_funding": {
          "field": "/extra_snippets/0",
          "kind": "money",
          "optional": true,
          "capture": "total funding to \\$(\\d+)",
          "units": [
            "million",
            "m",
            "mn"
          ],
          "require_unit": true
        }
      },
      "mode": "statements",
      "context": [
        "existing investor ${participating_investor} also participated",
        "bringing total funding to ${total_funding}",
        "with ${participating_investor} participating",
        "reported by ${news_source} on ${news_date}",
        "${participating_investor} participating",
        "${participating_investor} participated",
        "${participating_investor} also participated",
        "participation from existing investor ${participating_investor}",
        "participation from ${participating_investor}"
      ],
      "assertions": [
        "Amount: ${amount} Round: ${round} Lead investor: ${lead}",
        "${amount} ${round} led by ${lead}",
        "${amount}, ${round}, led by ${lead}",
        "Norvik Analytics raised ${amount} in a ${round} round led by ${lead}.",
        "${amount} dollars, ${round}, led by ${lead}",
        "${amount} ${round}, lead: ${lead}"
      ]
    }
  },
  "preservation": null,
  "interfaces": "mcp_only",
  "environment_faults": []
}
