    "record_facts": {
      "requirement": "Name the actor of the successful api_key.delete audit event for the key ci-deploy-bot on 2026-10-29 UTC and the UTC time (hour and minute) of that event, the login of the GitHub user whose email local part is that actor, the number of the pull request that user opened, and whether it is merged or still open.",
      "selector": {
