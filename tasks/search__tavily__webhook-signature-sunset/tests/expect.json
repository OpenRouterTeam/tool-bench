    "record_facts": {
      "requirement": "State the date on which Ferrowave stops sending v1 webhook signatures according to the webhook-signature guide of its current developer docs, and name the header that guide says to verify instead.",
      "selector": {
        "collection": "/services/tavily/pages",
        "matching": {},
        "field_patterns": {
          "/title": "(?i)webhook signatures",
          "/url": "^https://docs\\.ferrowave\\.dev/"
        },
        "key_prefix": null,
        "created": false,
        "identity_field": null
      },
      "selection": "only",
      "facts": {
