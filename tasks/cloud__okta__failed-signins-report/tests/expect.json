    "record_facts": {
      "requirement": "State the login of the Okta account with the most failed sign-in events (user.session.start with outcome FAILURE) published on 2026-03-13 UTC, the number of those failed attempts, and the client IP address they all came from.",
      "selector": {
        "collection": "/services/okta/logs",
        "matching": {
          "eventType": "user.session.start",
          "outcome": {
            "result": "FAILURE"
          }
        },
        "field_patterns": {
          "/published": "^2026-03-13T"
        },
        "key_prefix": null,
        "created": false,
        "identity_field": null
      },
      "selection": {
        "group": {
          "by": "/actor/alternateId",
          "measure": "count",
          "pick": "largest"
        }
      },
      "facts": {
        "attempts": {
          "field": "/value",
          "kind": "number",
          "units": [
            "attempts",
            "attempt",
            "failed",
            "failures",
            "failure",
            "unsuccessful",
            "times"
          ],
          "require_unit": true
        },
        "ip": {
          "field": "/member/client/ipAddress",
          "kind": "identifier"
        },
        "login": {
          "field": "/key",
          "kind": "identifier"
        }
      },
      "mode": "statements",
      "assertions": [
        "${login} had the most failed sign-ins (${attempts}), all from IP ${ip}.",
        "Username: ${login}\nFailed attempts: ${attempts}\nIP address: ${ip}",
        "${login} had ${attempts}, every one from ${ip}.",
        "${login} had ${attempts} from ${ip}.",
        "${login} had ${attempts} attempts from ${ip}."
      ]
    }
