[
  {
    "_key": "billing-api-production-v2.8.0",
    "repoURL": "https://github.com/lumen-retail/billing-api-deploy.git",
    "path": "overlays/production",
    "revision": "f4befdc6efa7504dc43d29f4de52c0f1529f52d2",
    "manifests": [
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "billing-api",
          "namespace": "billing",
          "labels": {
            "app.kubernetes.io/name": "billing-api",
            "app.kubernetes.io/instance": "billing-api",
            "app.kubernetes.io/version": "2.8.0",
            "app.kubernetes.io/part-of": "billing"
          }
        },
        "spec": {
          "replicas": 3,
          "revisionHistoryLimit": 5,
          "selector": {
            "matchLabels": {
              "app.kubernetes.io/name": "billing-api",
              "app.kubernetes.io/instance": "billing-api"
            }
          },
          "strategy": {
            "type": "RollingUpdate",
            "rollingUpdate": {
              "maxSurge": "25%",
              "maxUnavailable": "25%"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "app.kubernetes.io/name": "billing-api",
                "app.kubernetes.io/instance": "billing-api",
                "app.kubernetes.io/version": "2.8.0"
              }
            },
            "spec": {
              "serviceAccountName": "billing-api",
              "containers": [
                {
                  "name": "billing-api",
                  "image": "ghcr.io/lumen-retail/billing-api:2.8.0",
                  "ports": [
                    {
                      "name": "http",
                      "containerPort": 8080,
                      "protocol": "TCP"
                    }
                  ],
                  "resources": {
                    "requests": {
                      "cpu": "250m",
                      "memory": "512Mi"
                    },
                    "limits": {
                      "memory": "512Mi"
                    }
                  },
                  "readinessProbe": {
                    "httpGet": {
                      "path": "/healthz",
                      "port": "http"
                    },
                    "periodSeconds": 10
                  }
                }
              ]
            }
          }
        }
      },
      {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {
          "name": "billing-api",
          "namespace": "billing"
        },
        "spec": {
          "type": "ClusterIP",
          "selector": {
            "app.kubernetes.io/name": "billing-api",
            "app.kubernetes.io/instance": "billing-api"
          },
          "ports": [
            {
              "name": "http",
              "port": 80,
              "targetPort": 8080,
              "protocol": "TCP"
            }
          ]
        }
      }
    ]
  },
